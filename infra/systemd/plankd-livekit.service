[Unit]
Description=plankd LiveKit media server
After=network-online.target
Wants=network-online.target

[Service]
User=plankd
WorkingDirectory=/opt/plankd/app
EnvironmentFile=/opt/plankd/app/.env
ExecStart=/opt/plankd/bin/livekit-server --config /opt/plankd/app/infra/livekit.prod.yaml
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
